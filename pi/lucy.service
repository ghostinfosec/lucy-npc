[Unit]
Description=Lucy Ghost Zero — stuffed animal, live network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lucy
Group=lucy
WorkingDirectory=/opt/lucy/current
EnvironmentFile=-/etc/lucy/env
Environment=PYTHONPATH=/opt/lucy/current/src
ExecStart=/opt/lucy/.venv/bin/python -m lucy.daemon --persona /etc/lucy/persona.json --log-dir /opt/lucy/logs
Restart=always
RestartSec=8
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
# Chromium needs the network. Do not PrivateNetwork.
# ProtectSystem=strict breaks Playwright on Pi; Lucy user is the control instead.

[Install]
WantedBy=multi-user.target
