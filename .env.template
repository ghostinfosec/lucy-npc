# Copy to .env in this folder. lucy-daemon reads it (does not overwrite keys already in the environment).

# live_public is the default. live_http on a Pi Zero. live_session is a stub.
LUCY_ENGINE=live_public
LUCY_PERSONA=data/personas/wool.json
LUCY_LOG_DIR=logs
LUCY_STATUS_HOST=127.0.0.1
LUCY_STATUS_PORT=8787
# Required if you bind to the LAN. Also the local admin login.
LUCY_STATUS_TOKEN=

# Phone viewport inside the animal
LUCY_VIEWPORT_WIDTH=390
LUCY_VIEWPORT_HEIGHT=844
LUCY_TIMEZONE=America/Detroit
LUCY_LOCALE=en-US

# live_session (unimplemented): path to Playwright storage_state from YOUR browser
LUCY_STORAGE_STATE=

# Unused in v0.1. Do not expect model calls.
LUCY_MODEL_API_KEY=
LUCY_MODEL_BASE_URL=
LUCY_MCP_ENABLED=false

# Pull-only updates. Empty origin + AUTO_UPDATE=off = timer is a no-op if enabled.
# git = TOFU pull (same trust as clone). signed = not implemented.
LUCY_UPDATE_ORIGIN=
LUCY_AUTO_UPDATE=off
LUCY_UPDATE_REF=
LUCY_SLOT_ROOT=/opt/lucy/slots
LUCY_CURRENT_LINK=/opt/lucy/current
LUCY_STATE_DIR=/etc/lucy
LUCY_ALLOWLIST=/etc/lucy/allowlist.json
PLAYWRIGHT_BROWSERS_PATH=/opt/lucy/ms-playwright
